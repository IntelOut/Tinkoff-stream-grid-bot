# Токен API Тинькофф Инвестиции
# Получить можно в личном кабинете Тинькофф: https://www.tinkoff.ru/invest/
TINKOFF_TOKEN=your_token_here

# ID счета (опционально, если не указан - используется первый счет)
TINKOFF_ACCOUNT_ID=

# Путь к файлу базы данных SQLite
DATABASE_PATH=sqlite_bot.db

# Интервал проверки ордеров в секундах
# Бот проверяет, все ли ордера на месте, и восстанавливает пропущенные
ORDER_CHECK_INTERVAL=60

# Настройки сетки по умолчанию
GRID_LEVELS=6          # Количество уровней сетки
PRICE_STEP=0.01        # Шаг цены в процентах (1% = 0.01)
QUANTITY=1             # Количество лотов в ордере
